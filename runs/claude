#!/usr/bin/env bash
# DEPS: dev-env
source "$(dirname "${BASH_SOURCE[0]:-$0}")/_lib.sh"

log_section "Claude Code"
orphan_npm="/opt/homebrew/lib/node_modules/@anthropic-ai/claude-code"
if [[ -d "$orphan_npm" ]]; then
	log_step "Removing orphaned npm install at $orphan_npm"
	execute rm -rf "$orphan_npm"
fi
if claude --version &>/dev/null; then
	log_skip "Already installed, updating"
	execute claude update
else
	log_step "Installing Claude Code CLI"
	if [[ "$DRY" == "0" ]]; then
		curl -fsSL https://claude.ai/install.sh | bash
	fi
fi

log_section "claude-config"
claude_config_dir="$HOME/personal/claude-config"
clone_or_pull https://github.com/Forcebe/claude-config.git "$claude_config_dir"
# ~/.claude/skills and ~/.claude/agents used to be whole-directory symlinks
# into claude-config. A directory symlink cannot exclude individual entries, so
# on the work layer the repo's skills collided with the identically named ones
# in the tmrw-standards plugin. They are now real directories of per-entry
# links, rebuilt every run so a deleted skill or a layer switch leaves nothing
# orphaned behind.
link_entries() {
	local src="$1" dest="$2" skip="$3"
	local link entry name

	if [[ -L "$dest" ]]; then
		log_step "Replacing the $(basename "$dest") symlink with a directory"
		execute rm -f "$dest"
	fi
	execute mkdir -p "$dest"

	# Only links this script owns are removed, so anything else kept here
	# survives the rebuild.
	for link in "$dest"/*; do
		[[ -L "$link" ]] || continue
		[[ "$(readlink "$link")" == "$claude_config_dir"/* ]] || continue
		execute rm -f "$link"
	done

	for entry in "$src"/*; do
		[[ -e "$entry" ]] || continue
		# A directory with nothing in it is what git leaves behind when a skill's
		# files are deleted, and linking it deploys a skill that does not exist.
		if [[ -d "$entry" ]] && [[ -z "$(ls -A "$entry")" ]]; then continue; fi
		name=$(basename "$entry")
		[[ " $skip " == *" $name "* ]] && continue
		execute ln -sfn "$entry" "$dest/$name"
	done
}

# synced/ is written by Claude Code, not by hand. It only lived in the repo
# because the whole directory was the symlink target.
skills_skip="synced"
agents_skip=""
layer="${CURRENT_LAYER:-personal}"
if [[ "$layer" == "work" ]]; then
	# tmrw-standards ships its own code-review and review-loop, and two
	# definitions of one skill name is ambiguous. self-review and apply-review
	# have no plugin equivalent, so they stay on both layers.
	skills_skip="$skills_skip code-review review-loop"
fi

# Agents are deliberately NOT layer-dependent. The plugin ships cr-* files, but
# plugin agents surface under a "plugin:name" prefix, and these never appeared
# that way: the bare cr-* types every review skill spawns come from here. Skip
# them on the work layer and the review skills lose their subagents.

log_step "Linking skills/ and agents/ -> ~/.claude/ (layer: $layer)"
link_entries "$claude_config_dir/skills" "$HOME/.claude/skills" "$skills_skip"
link_entries "$claude_config_dir/agents" "$HOME/.claude/agents" "$agents_skip"

if [[ -d "$claude_config_dir/skills/synced" && ! -e "$HOME/.claude/skills/synced" ]]; then
	log_step "Moving synced skills out of the repo"
	execute mv "$claude_config_dir/skills/synced" "$HOME/.claude/skills/synced"
fi

# ~/.local/bin rather than ~/.local/scripts, which dev-env wipes and recopies
# on every run, taking any symlink into claude-config with it.
log_step "Linking cw and session-context -> ~/.local/bin/"
execute mkdir -p "$HOME/.local/bin"
execute ln -sfn "$claude_config_dir/scripts/cw" "$HOME/.local/bin/cw"
execute ln -sfn "$claude_config_dir/scripts/session-context" "$HOME/.local/bin/session-context"

log_manual "Run /reload-plugins in Claude Code to pick up changes"
